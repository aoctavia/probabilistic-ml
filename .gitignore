# Experiment outputs — results and figures are gitignored by default
# to keep the repo lightweight. Use `make reproduce` to regenerate.
experiments/*/results/*
experiments/*/figures/*

# But keep the directory structure
!experiments/*/results/.gitkeep
!experiments/*/figures/.gitkeep

# Real data files (can be large)
data/
*.h5
*.h5ad
*.loom
*.mtx
*.gz
